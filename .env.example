# ---------------------------------------------------------------------------
# AuditReady — environment configuration
#
# Copy to `.env` and adjust. Every external service has a working default that
# needs no credentials, so `npm run dev` works out of the box. Supplying real
# credentials swaps the provider without any code change.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Prisma datasource. SQLite by default; swap the provider in
# prisma/schema.prisma to "postgresql" and point this at a Postgres URL.
DATABASE_URL="file:./dev.db"

# Signing key for session cookies. REQUIRED in production — the app refuses to
# boot without it. Generate with: openssl rand -base64 48
AUTH_SECRET="dev-only-secret-change-me-0123456789abcdefghijklmnop"

# Absolute base URL, used for links in emails and Stripe redirects.
APP_URL="http://localhost:3000"

# Session lifetime in days (default 14).
# SESSION_DAYS="14"

# --- AI --------------------------------------------------------------------
# "mock"      deterministic offline analysis engine (no network, no key)
# "anthropic" live Claude analysis; falls back to the offline engine on error
AI_PROVIDER="mock"
# ANTHROPIC_API_KEY="sk-ant-..."
# AI_MODEL="claude-opus-5"
# AI_MAX_INPUT_CHARS="24000"

# --- Storage ---------------------------------------------------------------
# "local" writes to STORAGE_LOCAL_DIR; "s3" uses any S3-compatible bucket
# (AWS S3, Cloudflare R2, MinIO, Backblaze B2).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3_BUCKET="auditready-evidence"
# S3_REGION="us-east-1"
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"   # omit for AWS
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Upload ceiling per file, in megabytes.
MAX_UPLOAD_MB="25"

# OCR for image evidence. Requires the optional `tesseract.js` dependency.
OCR_ENABLED="false"

# --- Email -----------------------------------------------------------------
# "console" logs the message; "http" posts to a transactional email API.
EMAIL_PROVIDER="console"
EMAIL_FROM="AuditReady <notifications@auditready.app>"
# EMAIL_API_URL="https://api.resend.com/emails"
# EMAIL_API_KEY=""
# EMAIL_PAYLOAD_STYLE="resend"    # "resend" | "postmark"

# --- Billing ---------------------------------------------------------------
# "simulator" applies plan changes locally and labels them as simulated;
# "stripe" uses the real Checkout + billing portal + webhooks.
BILLING_PROVIDER="simulator"
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_STARTER="price_..."
# STRIPE_PRICE_PROFESSIONAL="price_..."
# STRIPE_PRICE_BUSINESS="price_..."
# STRIPE_PRICE_CONSULTANT="price_..."
