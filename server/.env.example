# ---------------------------------------------------------------------------
# PriceScout server configuration. Copy to server/.env and edit.
# The defaults run the whole app on SAMPLE DATA with no API keys at all.
# ---------------------------------------------------------------------------

PORT=4000
NODE_ENV=development

# SQLite file, relative to server/. Swap for a Postgres URL only if you also
# replace src/db/index.js.
DATABASE_FILE=data/pricescout.db

# Comma-separated list of allowed browser origins for the API.
CORS_ORIGIN=http://localhost:5173

# Required in production. Any long random string; `openssl rand -hex 32`.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_TTL=30d

# ---------------------------------------------------------------------------
# Data sources (PriceProvider implementations), in priority order.
#   mock       — built-in SAMPLE DATA, no key needed, the default
#   serpapi    — LIVE Google Shopping results, needs SERPAPI_KEY
#   rainforest — LIVE Amazon buybox prices, needs RAINFOREST_API_KEY
# Example for live multi-retailer pricing with a better Amazon number:
#   PRICE_PROVIDERS=serpapi,rainforest
# ---------------------------------------------------------------------------
PRICE_PROVIDERS=mock

# https://serpapi.com/ — Google Shopping API. Paid; small free tier.
SERPAPI_KEY=

# https://www.rainforestapi.com/ — Amazon product data. Paid.
RAINFOREST_API_KEY=
AMAZON_DOMAIN=amazon.com

PROVIDER_COUNTRY=us
PROVIDER_LANGUAGE=en
PROVIDER_TIMEOUT_MS=12000

# ---------------------------------------------------------------------------
# Scheduled price refresh
# ---------------------------------------------------------------------------
ENABLE_CRON=true
# Standard 5-field cron. Default: every 6 hours.
PRICE_REFRESH_CRON=0 */6 * * *
# Max tracked products re-quoted per run (caps paid API spend).
PRICE_REFRESH_BATCH=50
# Don't re-quote a product more often than this (minutes).
MIN_REFRESH_MINUTES=60

# ---------------------------------------------------------------------------
# Email alerts (optional — in-app notifications always work without this)
# https://resend.com/
# ---------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=PriceScout <alerts@yourdomain.com>
APP_URL=http://localhost:5173
