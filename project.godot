[layer_names]

3d_physics/layer_1="terrain"
3d_physics/layer_2="static_world"
3d_physics/layer_3="player"
3d_physics/layer_4="enemy"
3d_physics/layer_5="wildlife"
3d_physics/layer_6="interactable"
3d_physics/layer_7="prop"
3d_physics/layer_8="water"
3d_physics/layer_9="hide_volume"
3d_physics/layer_10="trigger"
3d_physics/layer_11="vision_blocker"

[physics]

3d/default_gravity=18.0
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/positional_shadow/atlas_size.mobile=1024
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
environment/defaults/default_clear_color=Color(0.02, 0.024, 0.027, 1)
# Occlusion culling is compiled out of the Web export template, so enabling it
# only produces a warning on the platform that needs it most. Visibility is
# handled instead by the chunk streaming radius, per-ring LOD and distance fog
# (see docs/systems/RENDERING.md).
occlusion_culling/use_occlusion_culling=false
limits/opengl/max_lights_per_object=4
