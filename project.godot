; Engine configuration file.
; "The Black Pine" - first-person survival horror, HTML5-first.
;
; Renderer note: gl_compatibility is used on every platform so that the browser
; build (WebGL2) behaves identically to the desktop editor. See
; docs/systems/RENDERING.md for the reasoning and the feature matrix.

config_version=5

[application]

config/name="The Black Pine"
config/description="A first-person survival horror game set in the Black Pine Basin. Built for HTML5/WebAssembly."
config/version="0.9.0"
run/main_scene="res://scenes/main/bootstrap.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.02, 0.024, 0.027, 1)
boot_splash/show_image=false

[autoload]

Log="*res://scripts/autoload/log.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
Platform="*res://scripts/autoload/platform.gd"
Settings="*res://scripts/autoload/settings.gd"
PerformanceDirector="*res://scripts/autoload/performance_director.gd"
AssetFoundry="*res://scripts/autoload/asset_foundry.gd"
AudioDirector="*res://scripts/autoload/audio_director.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
GameState="*res://scripts/autoload/game_state.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"

[debug]

gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/untyped_declaration=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[filesystem]

import/blender/enabled=false

[gui]

theme/default_font_antialiasing=1

